@Tutorial(time: 45) {
    @Intro(title: "Build an issue tracker") {
        A sidebar list with sections and an outline, a sortable, resizable table with multiple selection and context menus, and an inspector form.

        The walkthrough for this app is still being written. The finished app is
        in the repository's `Examples/Issues` folder, ready to build and read.
    }

    @Section(title: "Set up the package") {
        @ContentAndMedia {
            Each example is a Swift package of its own that depends on NucleantUI.
        }

        @Steps {
            @Step {
                Create a package named `Issues` with an executable target, and add
                NucleantUI to its dependencies.

                @Code(name: "Package.swift", file: "tutorial-issues-package.swift")
            }
        }
    }
}
