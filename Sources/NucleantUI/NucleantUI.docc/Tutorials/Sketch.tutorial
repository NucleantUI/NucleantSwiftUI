@Tutorial(time: 25) {
    @Intro(title: "Build a drawing pad") {
        A drag gesture collecting points into a stroked path, finished strokes as reusable views, colour and brush pickers, and undo.

        The walkthrough for this app is still being written. The finished app is
        in the repository's `Examples/Sketch` folder, ready to build and read.
    }

    @Section(title: "Set up the package") {
        @ContentAndMedia {
            Each example is a Swift package of its own that depends on NucleantUI.
        }

        @Steps {
            @Step {
                Create a package named `Sketch` with an executable target, and add
                NucleantUI to its dependencies.

                @Code(name: "Package.swift", file: "tutorial-sketch-package.swift")
            }
        }
    }
}
